# Hedge Fund Data Platform - Environment Configuration
# Copy to .env and customize for your environment

# CORS - comma-separated origins
HEDGE_CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# API Key (leave empty to disable auth in dev mode)
HEDGE_API_KEY=

# Environment
HEDGE_ENVIRONMENT=development

# Datalake
HEDGE_DATALAKE_ROOT=datalake

# Logging
HEDGE_LOG_LEVEL=INFO

# Ingest concurrency (default per source)
HEDGE_DEFAULT_CONCURRENCY=4

# Floci (LocalStack)
FLOCI_SUDO_PASSWORD=

# Ingestion UI
SPRING_PROFILES_ACTIVE=default
