    {
      "title": "Ingest Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [{ "expr": "rate(hedge_ingest_fetch_total[5m])", "legendFormat": "{{source}}" }]
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [{ "expr": "rate(hedge_ingest_errors_total[5m])", "legendFormat": "{{source}}" }]
    },
    {
      "title": "Fetch Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
